# Copy this file to .env and replace the two host paths.
PUID=1000
PGID=1000
TZ=Europe/London

# Required login for the browser desktop (use a unique password).
CUSTOM_USER=atmos
PASSWORD=change-this-to-a-long-unique-password

# Folder containing your ripped Blu-ray folders (each rip contains BDMV/PLAYLIST).
RIPS_PATH=/data/atmos-rips

# Your existing Plex Music Videos library folder.
MUSIC_VIDEOS_PATH="/path/to/Music Videos"
