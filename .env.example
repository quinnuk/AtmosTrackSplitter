# Docker user IDs confirmed on the Dell.
PUID=1000
PGID=1000
TZ=Europe/London
WEB_PORT=8765

# Required browser login. Replace both values with your own credentials.
AUTH_USERNAME=atmos
AUTH_PASSWORD=replace-with-a-long-unique-password

# Host-side bind mount for the dedicated qBittorrent audio Blu-ray category.
RIPS_DIR=/data/torrents/audio-bluray

# Existing Plex Music Videos library on the mergerfs pool.
OUTPUT_DIR=/data/media/music-videos

# ISO extraction workspace on the physical MEDIA4TB ext4 filesystem.
# This avoids using mergerfs pooled free-space figures for ISO staging checks.
STAGING_DIR=/mnt/disks/MEDIA4TB/torrents/audio-bluray-staging

# 1080p qBittorrent Web UI. Enter the qBittorrent WebUI username/password below.
QBITTORRENT_URL=http://192.168.0.89:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=audio-bluray

# Absolute category download path as seen INSIDE qbittorrent-1080p.
QBITTORRENT_CONTENT_ROOT=/data/torrents/audio-bluray

# Optional Discogs personal access token.
DISCOGS_TOKEN=
