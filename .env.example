# Docker user IDs. On the Dell, check with: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/London
WEB_PORT=8765

# Required browser login. Replace both values before starting the container.
AUTH_USERNAME=atmos
AUTH_PASSWORD=replace-with-a-long-unique-password

# Dedicated qBittorrent audio Blu-ray category folder (mounted read-only).
RIPS_DIR=/data/torrents/audio-bluray

# Existing Plex Music Videos library.
OUTPUT_DIR=/data/media/music-videos

# Writable temporary workspace for Blu-ray ISO extraction.
STAGING_DIR=/data/torrents/audio-bluray-staging

# Optional Discogs personal access token.
DISCOGS_TOKEN=
