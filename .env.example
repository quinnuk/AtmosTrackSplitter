# Copy this file to .env and replace the example password and qBittorrent details.
PUID=1000
PGID=1000
TZ=Europe/London

# Required login for the browser desktop (use a unique password).
CUSTOM_USER=atmos
PASSWORD=change-this-to-a-long-unique-password

# Your qBittorrent category and its host folder.
QBITTORRENT_CATEGORY=audio-bluray

# Address of the qBittorrent Web UI as reachable from this Docker container.
# The usual Dell LAN URL is shown as an example; confirm your actual Web UI port.
QBITTORRENT_URL=http://192.168.0.89:8080
QBITTORRENT_USERNAME=your-qbittorrent-webui-username
QBITTORRENT_PASSWORD=your-qbittorrent-webui-password

# IMPORTANT: this is the category's absolute path as seen INSIDE the qBittorrent container,
# not the Dell host path. Example only - confirm the path in qBittorrent's container.
QBITTORRENT_CONTENT_ROOT=/downloads/audio-bluray

# Host folder containing your audio-bluray category downloads (mounted read-only).
RIPS_PATH=/data/torrents/audio-bluray

# Writable temporary workspace for Blu-ray ISO extraction; use the same storage pool as the downloads.
STAGING_PATH=/data/torrents/audio-bluray-staging

# Your existing Plex Music Videos library folder.
MUSIC_VIDEOS_PATH=/data/media/music-videos
